# Copy to .env and fill in. Never commit the real .env - it is gitignored.

# Microsoft account used to sign in to odoo.cust.edu.pk.
# login.mjs drives a real browser through the OAuth flow with these, so the
# session cookie refreshes itself and never has to be pasted by hand.
CUST_EMAIL=
CUST_PASSWORD=

# Optional. A portal session id, if you want to start from one you already
# have instead of logging in. Left empty, the bot logs in on first use.
CUST_SESSION=

# Optional. Only needed to pair WhatsApp with an 8-character code instead of
# a QR (npm run pair -- --code). Format: 923001234567
PAIR_NUMBER=

# Optional overrides.
# SCRAPE_EVERY_MINUTES=45   # full portal scrape interval
# TICK_MINUTES=5            # clock check; no network unless something is due
# PLAYWRIGHT_CHANNEL=       # empty = bundled Chromium (Linux); default msedge

# Hours the scheduled scrape runs, Pakistan time. The window may wrap past
# midnight. Attendance checks around a class, deadline reminders and anything
# you type in chat ignore this and always run.
# ACTIVE_FROM=07:00
# ACTIVE_UNTIL=00:30
